    "You should avoid using %@ apps like %@ around bedtime to have a better quality sleep.": {
      "comment": "Bedtime shield message, first %@ is the category name, second %@ is the app's name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide %1$@-Apps wie %2$@ kurz vor dem Schlafengehen, um besser zu schlafen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita las apps de %1$@ como %2$@ cerca de la hora de dormir para descansar mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez les applis %1$@ comme %2$@ à l'approche du coucher pour mieux dormir."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Évite les applis %1$@ comme %2$@ à l'approche du coucher pour mieux dormir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik %1$@-apps zoals %2$@ liever niet vlak voor het slapengaan, dan slaap je beter."
          }
        }
      }
    },
