          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveles de estrés y sesiones de mindfulness. Ayudan a Bud a responder preguntas sobre tus patrones de estrés y ofrecer análisis personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveaux de stress et séances de pleine conscience. Permet à Bud de répondre à vos questions sur vos tendances de stress et de vous proposer des conseils personnalisés."
          }
        },
        "fr-CA": {
