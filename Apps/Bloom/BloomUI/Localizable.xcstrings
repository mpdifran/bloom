    "Weather conditions for your location, but not your location itself. Used to help Bud understand external factors that may affect your health.": {
      "comment": "Description for AI health category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wetterlage an deinem Standort, nicht der Standort selbst. Damit berücksichtigt Bud äußere Einflüsse auf deine Gesundheit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions météo de votre région, sans votre position elle-même. Permet à Bud de tenir compte des facteurs extérieurs qui peuvent influencer votre santé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions météo de ton région, sans ta position elle-même. Permet à Bud de tenir compte des facteurs extérieurs qui peuvent influencer ta santé."
          }
        }
      }
    },
    "Your coarse location (city, state, country). Used to help Bud understand environmental context and provide location-aware insights, without knowing your exact position.": {
      "comment": "Description for AI health category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein ungefährer Standort (Stadt, Region, Land). Damit berücksichtigt Bud dein Umfeld und liefert ortsbezogene Erkenntnisse, ohne deine genaue Position zu kennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre localisation approximative (ville, région, pays). Permet à Bud de tenir compte du contexte environnemental et de proposer des analyses adaptées à votre région, sans connaître votre position exacte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton localisation approximative (ville, région, pays). Permet à Bud de tenir compte du contexte environnemental et de proposer des analyses adaptées à ton région, sans connaître ta position exacte."
          }
        }
      }
    },
    "Your health goals and progress. Used to help Bud contextualize your questions and generate personalized suggestions.": {
      "comment": "Description for AI health category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Gesundheitsziele und Fortschritte. Damit ordnet Bud deine Fragen ein und macht persönliche Vorschläge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos objectifs de santé et votre progression. Permet à Bud de replacer vos questions dans leur contexte et de générer des suggestions personnalisées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "tes objectifs de santé et ta progression. Permet à Bud de replacer tes questions dans leur contexte et de générer des suggestions personnalisées."
          }
        }
      }
    }
