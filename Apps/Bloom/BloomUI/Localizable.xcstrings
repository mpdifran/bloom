    },
    "Age, biological sex, height, and your focus. Used to help Bud personalize responses and tailor insights to you.": {
      "comment": "Description for AI health category",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Âge, sexe biologique, taille et votre objectif. Permet à Bud de personnaliser ses réponses et d'adapter ses conseils à votre situation."
          }
        }
      }
    },
    "Alcohol consumption and smoking status. Used to help Bud understand lifestyle factors that may affect your health.": {
      "comment": "Description for AI health category",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consommation d'alcool et statut tabagique. Permet à Bud de comprendre les facteurs liés à votre mode de vie qui peuvent influencer votre santé."
          }
        }
      }
    },
