    "Age, biological sex, height, and your focus. Used to help Bud personalize responses and tailor insights to you.": {
      "comment": "Description for AI health category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alter, biologisches Geschlecht, Größe und dein Schwerpunkt. Damit passt Bud seine Antworten und Erkenntnisse an dich an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Âge, sexe biologique, taille et votre objectif. Permet à Bud de personnaliser ses réponses et d'adapter ses conseils à votre situation."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Âge, sexe biologique, taille et ton objectif. Permet à Bud de personnaliser ses réponses et d'adapter ses conseils à ton situation."
          }
        }
      }
    },
    "Alcohol consumption and smoking status. Used to help Bud understand lifestyle factors that may affect your health.": {
      "comment": "Description for AI health category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkoholkonsum und Rauchstatus. Damit versteht Bud Lebensstilfaktoren, die deine Gesundheit beeinflussen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consommation d'alcool et statut tabagique. Permet à Bud de comprendre les facteurs liés à votre mode de vie qui peuvent influencer votre santé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Consommation d'alcool et statut tabagique. Permet à Bud de comprendre les facteurs liés à ton mode de vie qui peuvent influencer ta santé."
          }
        }
      }
    },
