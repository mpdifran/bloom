    "Sleep duration, quality, and stages. Used to help Bud answer questions about your sleep patterns and provide personalized insights.": {
      "comment": "Description for AI health category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafdauer, -qualität und -phasen. Damit beantwortet Bud Fragen zu deinem Schlafverhalten und liefert persönliche Erkenntnisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duración, calidad y fases del sueño. Ayuda a Bud a responder preguntas sobre tus hábitos de sueño y ofrecer análisis personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée, qualité et phases de sommeil. Permet à Bud de répondre à vos questions sur vos habitudes de sommeil et de vous proposer des conseils personnalisés."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée, qualité et phases de sommeil. Permet à Bud de répondre à tes questions sur tes habitudes de sommeil et de te proposer des conseils personnalisés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaapduur, -kwaliteit en -fasen. Hiermee beantwoordt Bud vragen over je slaappatroon en geeft hij persoonlijke inzichten."
          }
        }
      }
    },
    "Steps, workouts, training load, and exercise data. Used to provide personalized activity insights and answer your activity-related questions.": {
      "comment": "Description for AI health category",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte, Workouts, Trainingsbelastung und Bewegungsdaten. Damit erhältst du persönliche Aktivitätserkenntnisse und Antworten zu deinem Training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos, entrenamientos, carga de entrenamiento y datos de ejercicio. Permiten ofrecerte análisis de actividad personalizados y responder tus preguntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas, séances, charge d'entraînement et données d'exercice. Permet de vous proposer des analyses d'activité personnalisées et de répondre à vos questions sur l'activité physique."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas, séances, charge d'entraînement et données d'exercice. Permet de te proposer des analyses d'activité personnalisées et de répondre à tes questions sur l'activité physique."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stappen, trainingen, trainingsbelasting en beweeggegevens. Hiermee krijg je persoonlijke inzichten en antwoorden over je activiteit."
          }
        }
      }
    },
