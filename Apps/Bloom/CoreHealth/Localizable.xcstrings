    "Limited health data is available. Track more health metrics to get a more accurate biological age.": {
      "comment": "Description for biological age confidence",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegen nur wenige Gesundheitsdaten vor. Erfasse mehr Werte, um dein biologisches Alter genauer zu bestimmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peu de données de santé sont disponibles. Suivez davantage de mesures pour obtenir un âge biologique plus précis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn weinig gezondheidsgegevens beschikbaar. Houd meer waarden bij voor een nauwkeuriger biologische leeftijd."
          }
        }
      }
    },
