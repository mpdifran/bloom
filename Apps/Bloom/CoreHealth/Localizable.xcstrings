    "Your biological age is based on a moderate amount of health data. Adding more metrics will improve accuracy.": {
      "comment": "Description for biological age confidence",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein biologisches Alter beruht auf einer mittleren Menge an Gesundheitsdaten. Mit weiteren Werten wird es genauer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu edad biológica se basa en una cantidad moderada de datos de salud. Añadir más métricas mejorará la precisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre âge biologique repose sur un nombre modéré de données de santé. Ajouter d'autres mesures en améliorera la précision."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton âge biologique repose sur un nombre modéré de données de santé. Ajouter d'autres mesures en améliorera la précision."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je biologische leeftijd is gebaseerd op een beperkte set gezondheidsgegevens. Meer waarden maken het nauwkeuriger."
          }
        }
      }
    },
    "Your biological age is calculated using most of your available health metrics.": {
      "comment": "Description for biological age confidence",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein biologisches Alter wird aus den meisten deiner verfügbaren Gesundheitswerte berechnet."
          }
        },
        "es": {
