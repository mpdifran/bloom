    "Low" : {
      "comment" : "Display name for blood pressure category\nDisplay name for sleep vitals monthly summary",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrig"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basse"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basse"
