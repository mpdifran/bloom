    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Shown when Bloom asks for calendar access, used by the morning report.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit ich dir jeden Morgen deine anstehenden Termine zeigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Show you your upcoming events every morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para mostrarte tus próximos eventos cada mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour vous montrer vos événements à venir chaque matin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour te montrer tes événements à venir chaque matin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om je elke ochtend je aankomende afspraken te laten zien."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Shown when Bloom asks for camera access, used for barcode and label scanning.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zum Scannen von Barcodes für die Ernährungserfassung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Scanning barcodes for food tracking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para escanear códigos de barras y registrar alimentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour scanner les codes-barres et enregistrer vos aliments."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour scanner les codes-barres et enregistrer tes aliments."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om barcodes te scannen voor het bijhouden van voeding."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Shown when Bloom asks to read Health data.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um Auffälligkeiten in deiner Gesundheit zu erkennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Help identify areas of concern with your health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para ayudar a identificar aspectos de tu salud que merecen atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour repérer les points de votre santé qui méritent votre attention."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour repérer les points de ta santé qui méritent ton attention."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om aandachtspunten in je gezondheid te herkennen."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Shown when Bloom asks to write Health data.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um Auffälligkeiten in deiner Gesundheit zu erkennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Help identify areas of concern with your health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para ayudar a identificar aspectos de tu salud que merecen atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour repérer les points de votre santé qui méritent votre attention."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour repérer les points de ta santé qui méritent ton attention."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om aandachtspunten in je gezondheid te herkennen."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Shown when the iOS app asks for location, used for local weather.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Um dir das Wetter an deinem Standort zu zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Show you weather for your location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para mostrarte el tiempo de tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour vous montrer la météo de votre région."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour te montrer la météo de ta région."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om je het weer op je locatie te laten zien."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Shown when Bloom asks for microphone access, used for voice food logging.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom braucht Zugriff auf dein Mikrofon, um Mahlzeiten per Sprache aufzuzeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Bloom needs access to your microphone to record voice food logs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom necesita acceso a tu micrófono para registrar comidas por voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom a besoin de votre microphone pour enregistrer vos repas à la voix."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom a besoin de ton microphone pour enregistrer tes repas à la voix."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom heeft toegang tot je microfoon nodig om maaltijden met je stem vast te leggen."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Shown when Bloom asks for speech recognition, used for voice food logging.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom nutzt Spracherkennung, damit du deine Mahlzeiten per Sprache erfassen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Bloom uses speech recognition to help you log your meals by voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom usa reconocimiento de voz para ayudarte a registrar tus comidas hablando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom utilise la reconnaissance vocale pour vous aider à enregistrer vos repas à la voix."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom utilise la reconnaissance vocale pour t'aider à enregistrer tes repas à la voix."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bloom gebruikt spraakherkenning zodat je je maaltijden kunt inspreken."
          }
        }
      }
    }
  },
  "version": "1.0"
}
