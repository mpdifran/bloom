    "You averaged %@ of sleep per night.": {
      "comment": "Year in Bloom sleep summary. The placeholder is an average nightly sleep duration.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast im Schnitt %@ pro Nacht geschlafen."
