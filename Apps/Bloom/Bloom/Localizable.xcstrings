    "Health data can feel overwhelming. I’m here to make things simple.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheitsdaten können erschlagend wirken. Ich mache es dir einfach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de salud pueden abrumar. Estoy aquí para simplificarlo todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de santé, ça peut vite devenir intimidant. Je suis là pour simplifier tout ça."
