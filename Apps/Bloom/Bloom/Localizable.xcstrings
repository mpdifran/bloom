    "Your personal data always remains anonymous. Always consult with a doctor before making any changes to your health.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten bleiben stets anonym. Sprich mit einer Ärztin oder einem Arzt, bevor du etwas an deiner Gesundheit änderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos siempre son anónimos. Consulta siempre con un médico antes de cambiar algo relacionado con tu salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données personnelles restent toujours anonymes. Consultez toujours un médecin avant de modifier quoi que ce soit concernant votre santé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "tes données personnelles restent toujours anonymes. Consulte toujours un médecin avant de modifier quoi que ce soit concernant ta santé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens blijven altijd anoniem. Overleg altijd met een arts voordat je iets aan je gezondheid verandert."
          }
        }
      }
    },
    "Your personal data is used for:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten werden verwendet für:"
          }
        },
        "es": {
