            "value": "Nächstes Jahr ist noch Luft nach oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El año que viene hay margen de mejora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de la marge pour progresser l'an prochain."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a de la marge pour progresser l'an prochain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgend jaar valt er nog winst te halen."
          }
        }
      }
    },
    "Thinking...": {
      "comment": "Placeholder shown while Bud's monitor insight is loading",
      "extractionState": "manual",
      "localizations": {
