    "Steps are compared to the previous period of the same length. The faded line represents the previous period.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schritte werden mit dem gleich langen Vorzeitraum verglichen. Die blasse Linie steht für den Vorzeitraum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pas sont comparés à la période précédente de même durée. La courbe estompée représente la période précédente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stappen worden vergeleken met de vorige periode van dezelfde lengte. De vage lijn is die vorige periode."
