          }
        }
      }
    },
    "Your data is always safe:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont toujours protégées :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "tes données sont toujours protégées :"
          }
        }
      }
    },
    "Your diet averaged %@ protein, %@ carbs, %@ fat.": {
      "comment": "Year in Bloom macro summary. Placeholders are protein, carbohydrate and fat percentages.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your diet averaged %1$@ protein, %2$@ carbs, %3$@ fat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre alimentation comptait en moyenne %1$@ de protéines, %2$@ de glucides et %3$@ de lipides."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton alimentation comptait en moyenne %1$@ de protéines, %2$@ de glucides et %3$@ de lipides."
          }
        }
      }
    },
    "Your heart rate during sleep is typically lower than your resting heart rate during the day. A lower sleep heart rate generally indicates better cardiovascular fitness and recovery.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fréquence cardiaque pendant le sommeil est généralement plus basse que votre fréquence au repos en journée. Une valeur plus basse traduit en général une meilleure condition cardiovasculaire et une bonne récupération."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fréquence cardiaque pendant le sommeil est généralement plus basse que ta fréquence au repos en journée. Une valeur plus basse traduit en général une meilleure condition cardiovasculaire et une bonne récupération."
          }
        }
      }
    },
    "Your personal data always remains anonymous. Always consult with a doctor before making any changes to your health.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données personnelles restent toujours anonymes. Consultez toujours un médecin avant de modifier quoi que ce soit concernant votre santé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "tes données personnelles restent toujours anonymes. Consulte toujours un médecin avant de modifier quoi que ce soit concernant ta santé."
          }
        }
      }
    },
    "Your personal data is used for:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données personnelles servent à :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "tes données personnelles servent à :"
          }
        }
      }
    },
    "Your resting heart rate averaged %@": {
      "comment": "Year in Bloom heart summary. The placeholder is an average resting heart rate.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fréquence cardiaque au repos était de %@ en moyenne"
          }
