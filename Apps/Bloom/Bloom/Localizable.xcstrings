    "Brief awakenings are normal and often go unremembered. Excessive wake time may indicate sleep disruption.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzes Aufwachen ist normal und bleibt oft unbemerkt. Viel Wachzeit kann auf gestörten Schlaf hindeuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los despertares breves son normales y a menudo no se recuerdan. Un tiempo despierto excesivo puede indicar sueño interrumpido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les brefs réveils sont normaux et passent souvent inaperçus. Un temps d'éveil excessif peut signaler un sommeil perturbé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les brefs réveils sont normaux et passent souvent inaperçus. Un temps d'éveil excessif peut signaler un sommeil perturbé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte momenten van wakker worden zijn normaal en blijven vaak onopgemerkt. Veel wakkere tijd kan wijzen op verstoorde slaap."
          }
        }
      }
    },
