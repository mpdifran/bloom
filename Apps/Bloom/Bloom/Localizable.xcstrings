    "screenshot.chat.workoutDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine 45-minütige Indoor-Bike-Einheit mit 4x4-minütigen intensiven Intervallen für mehr VO₂max."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
