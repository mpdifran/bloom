    "I can calculate your biological age and keep track of your vitals.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann dein biologisches Alter berechnen und deine Vitalwerte im Blick behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux calculer votre âge biologique et suivre vos constantes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux calculer ton âge biologique et suivre tes constantes."
          }
        },
