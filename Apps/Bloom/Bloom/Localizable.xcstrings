        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre alimentation comptait en moyenne %1$@ de protéines, %2$@ de glucides et %3$@ de lipides."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton alimentation comptait en moyenne %1$@ de protéines, %2$@ de glucides et %3$@ de lipides."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voeding bestond gemiddeld uit %1$@ eiwit, %2$@ koolhydraten en %3$@ vet."
          }
        }
      }
    },
    "Your heart rate during sleep is typically lower than your resting heart rate during the day. A lower sleep heart rate generally indicates better cardiovascular fitness and recovery.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schlaf liegt deine Herzfrequenz meist unter deiner Ruheherzfrequenz am Tag. Ein niedrigerer Wert spricht in der Regel für bessere Ausdauer und Erholung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frecuencia cardíaca durante el sueño suele ser menor que la de reposo durante el día. Una frecuencia más baja al dormir indica normalmente mejor condición y recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fréquence cardiaque pendant le sommeil est généralement plus basse que votre fréquence au repos en journée. Une valeur plus basse traduit en général une meilleure condition cardiovasculaire et une bonne récupération."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta fréquence cardiaque pendant le sommeil est généralement plus basse que ta fréquence au repos en journée. Une valeur plus basse traduit en général une meilleure condition cardiovasculaire et une bonne récupération."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hartslag tijdens de slaap ligt meestal lager dan je rusthartslag overdag. Een lagere slaaphartslag wijst doorgaans op een betere conditie en beter herstel."
          }
        }
      }
    },
    "Your Morning Report is Ready": {
      "comment": "Title of a sample notification (SwiftUI preview only).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
