    "Track meals, calories, and macros in one place.": {
      "comment": "Row body listing what personal data is used for. 'Macros' means macronutrients.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge Mahlzeiten, Kalorien und Makros an einem Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra comidas, calorías y macros en un solo lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos repas, vos calories et vos macros au même endroit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis tes repas, tes calories et tes macros au même endroit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd maaltijden, calorieën en macro's op één plek bij."
          }
        }
      }
    },
    "Track more cardio workouts to see your fitness level.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne mehr Cardio-Workouts auf, um dein Fitnessniveau zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra más entrenamientos de cardio para ver tu nivel de forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez plus de séances de cardio pour voir votre niveau de forme."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre plus de séances de cardio pour voir ton niveau de forme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg meer cardiotrainingen vast om je fitheidsniveau te zien."
          }
        }
      }
    },
    "Track sleep duration, deep sleep, and consistency. Get alerted when your rhythm is off so you can course-correct before fatigue builds up.": {
      "comment": "Paywall monitor showcase card body.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge Schlafdauer, Tiefschlaf und Regelmäßigkeit. Du bekommst Bescheid, wenn dein Rhythmus kippt – und kannst gegensteuern, bevor sich Müdigkeit aufbaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla la duración del sueño, el sueño profundo y la constancia. Te avisamos cuando tu ritmo se desajusta para que corrijas antes de que se acumule el cansancio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez la durée de votre sommeil, votre sommeil profond et votre régularité. Vous êtes prévenu dès que votre rythme dérape, pour rectifier avant que la fatigue s’installe."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis la durée de ton sommeil, ton sommeil profond et ta régularité. Tu es prévenu dès que ton rythme dérape, pour rectifier avant que la fatigue s’installe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg je slaapduur, diepe slaap en regelmaat. Je krijgt een seintje zodra je ritme uit de pas loopt, zodat je bijstuurt voordat de vermoeidheid zich opstapelt."
          }
        }
      }
    },
    "Track what you eat!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge, was du isst!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Registra lo que comes!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez ce que vous mangez !"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis ce que tu manges !"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd bij wat je eet!"
          }
        }
      }
    },
    "Track your alcohol consumption using the Drinks action card to see your weekly intake here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse deinen Alkoholkonsum über die Getränke-Karte, um hier deine Wochenmenge zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu consumo de alcohol con la tarjeta Bebidas para ver aquí tu total semanal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre consommation d'alcool avec la carte Boissons pour voir votre total hebdomadaire ici."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis ta consommation d'alcool avec la carte Boissons pour voir ton total hebdomadaire ici."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je alcoholgebruik bij met de kaart Drankjes om hier je weektotaal te zien."
          }
        }
      }
    },
    "Track your food to get more insights into your Nutrition.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse dein Essen, um mehr über deine Ernährung zu erfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tus comidas para obtener más información sobre tu nutrición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos aliments pour obtenir plus d'analyses sur votre nutrition."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre tes aliments pour obtenir plus d'analyses sur ton nutrition."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je voeding bij voor meer inzicht in je voedingspatroon."
          }
        }
      }
    },
    "Track your mobility by carrying your iPhone throughout the day or wearing your Apple Watch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse deine Mobilität, indem du dein iPhone bei dir trägst oder deine Apple Watch anlegst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu movilidad llevando el iPhone encima durante el día o poniéndote el Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre mobilité en gardant votre iPhone sur vous durant la journée ou en portant votre Apple Watch."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis ton mobilité en gardant ton iPhone sur tu durant la journée ou en portant ton Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je mobiliteit bij door je iPhone bij je te dragen of je Apple Watch om te doen."
          }
        }
      }
    },
    "Track your period in Apple Health to learn more about your cycle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse deine Periode in Apple Health, um mehr über deinen Zyklus zu erfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu regla en Apple Salud para conocer mejor tu ciclo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos règles dans l'app Santé pour en savoir plus sur votre cycle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis tes règles dans l'app Santé pour en savoir plus sur ton cycle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je menstruatie bij in Apple Gezondheid voor meer inzicht in je cyclus."
          }
        }
