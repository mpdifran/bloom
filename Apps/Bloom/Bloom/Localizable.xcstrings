          }
        }
      }
    },
    "Energy Ratio is the ratio between your Basal Energy and TDEE (Total Daily Energy Exertion) for a given day. The higher the ratio, the more active you were.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ratio énergétique compare votre énergie de base à votre DEJ (dépense énergétique journalière) pour une journée donnée. Plus il est élevé, plus vous avez été actif."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ratio énergétique compare ton énergie de base à ton DEJ (dépense énergétique journalière) pour une journée donnée. Plus il est élevé, plus tu as été actif."
          }
        }
      }
    },
    "Enjoying Bloom?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom vous plaît ?"
