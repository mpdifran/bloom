    "Energy Ratio": {
      "comment": "Chart header on a health detail screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Energieverhältnis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporción energética"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratio énergétique"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratio énergétique"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energieverhouding"
          }
        }
      }
    },
    "Energy Ratio is the ratio between your Basal Energy and TDEE (Total Daily Energy Exertion) for a given day. The higher the ratio, the more active you were.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Energieverhältnis setzt deinen Grundumsatz ins Verhältnis zum Gesamtumsatz eines Tages. Je höher der Wert, desto aktiver warst du."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La proporción energética compara tu energía basal con tu gasto energético total del día. Cuanto mayor es, más activo has estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ratio énergétique compare votre énergie de base à votre DEJ (dépense énergétique journalière) pour une journée donnée. Plus il est élevé, plus vous avez été actif."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ratio énergétique compare ton énergie de base à ton DEJ (dépense énergétique journalière) pour une journée donnée. Plus il est élevé, plus tu as été actif."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De energieverhouding vergelijkt je basaalverbruik met je totale dagverbruik. Hoe hoger de verhouding, hoe actiever je was."
          }
        }
      }
    },
    "Enjoying Bloom?": {
