    "Daily bowel movements (8-24 hours) are considered optimal for most people, indicating healthy digestive function.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Täglicher Stuhlgang (alle 8-24 Stunden) gilt für die meisten Menschen als optimal und spricht für eine gesunde Verdauung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las deposiciones diarias (cada 8-24 horas) se consideran óptimas para la mayoría e indican una digestión saludable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des selles quotidiennes (toutes les 8 à 24 heures) sont considérées comme optimales pour la plupart des gens et témoignent d'une bonne digestion."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Des selles quotidiennes (toutes les 8 à 24 heures) sont considérées comme optimales pour la plupart des gens et témoignent d'une bonne digestion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagelijkse stoelgang (elke 8-24 uur) geldt voor de meeste mensen als optimaal en wijst op een gezonde spijsvertering."
          }
        }
      }
    },
