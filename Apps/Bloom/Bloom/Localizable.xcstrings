    "Walking speed is a key indicator of mobility and overall health. Reference lines show typical speeds for different ages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gehgeschwindigkeit ist ein wichtiger Hinweis auf Mobilität und Gesundheit. Die Referenzlinien zeigen typische Werte je Altersgruppe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad al caminar es un indicador clave de movilidad y salud general. Las líneas de referencia muestran velocidades habituales por edad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse de marche est un indicateur clé de la mobilité et de la santé générale. Les lignes de référence indiquent les vitesses habituelles selon l'âge."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse de marche est un indicateur clé de la mobilité et de la santé générale. Les lignes de référence indiquent les vitesses habituelles selon l'âge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je loopsnelheid zegt veel over je mobiliteit en gezondheid. De referentielijnen tonen gebruikelijke snelheden per leeftijd."
          }
        }
      }
    },
    "walking-running distance": {
