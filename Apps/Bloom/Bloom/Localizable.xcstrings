    "Bloom Plus processes de-identified summaries of your personal data securely with OpenAI to generate personalized insights.": {
      "comment": "Body of the paywall card explaining how personal data is processed.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom Plus verarbeitet anonymisierte Zusammenfassungen deiner persönlichen Daten sicher mit OpenAI, um personalisierte Insights zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom Plus procesa de forma segura resúmenes anonimizados de tus datos personales con OpenAI para generar insights personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom Plus traite de manière sécurisée des résumés anonymisés de vos données personnelles avec OpenAI afin de générer des analyses personnalisées."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom Plus traite de manière sécurisée des résumés anonymisés de tes données personnelles avec OpenAI afin de générer des analyses personnalisées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom Plus verwerkt geanonimiseerde samenvattingen van je persoonlijke gegevens veilig met OpenAI om gepersonaliseerde inzichten te maken."
          }
        }
      }
    },
    "Bloom Plus Yearly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloom Plus jährlich"
          }
