    "No generic plans. No one-size-fits-all tips. Just real insights based on your real data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Standardpläne. Keine Tipps von der Stange. Nur echte Erkenntnisse aus deinen echten Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de programme générique. Pas de conseils passe-partout. Que des analyses concrètes fondées sur vos données réelles."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de programme générique. Pas de conseils passe-partout. Que des analyses concrètes fondées sur tes données réelles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen standaardplannen. Geen tips voor iedereen. Alleen echte inzichten uit jouw echte gegevens."
          }
        }
      }
    },
