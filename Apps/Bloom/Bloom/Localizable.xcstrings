    },
    "Thank you so much for help testing Bloom! We're ending our TestFlight program, so you'll need to install the App Store version of the app to continue using Bloom.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielen Dank, dass du Bloom getestet hast! Wir beenden unser TestFlight-Programm - installiere die App-Store-Version, um Bloom weiter zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci beaucoup d'avoir participé aux tests de Bloom ! Notre programme TestFlight prend fin : installez la version de l'App Store pour continuer à utiliser Bloom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heel erg bedankt voor het testen van Bloom! We stoppen met ons TestFlight-programma, dus installeer de App Store-versie om Bloom te blijven gebruiken."
          }
        }
      }
    },
