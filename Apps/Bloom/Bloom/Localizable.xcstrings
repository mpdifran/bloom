    "Wrist Temperature": {
      "comment": "Display name for monitor metric type",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handgelenktemperatur"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Température au poignet"
          }
        },
        "nl": {
