    "Walking Speed": {
      "comment": "Chart header on a health detail screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehtempo"
          }
        },
        "es": {
