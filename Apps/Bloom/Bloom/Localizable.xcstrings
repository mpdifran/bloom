    "screenshot.chat.question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, kannst du dafür ein Indoor-Cycling-Workout erstellen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeah can you create an indoor cycling workout for this?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, ¿puedes crear un entrenamiento de ciclismo indoor para esto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, peux-tu créer une séance de vélo en salle pour ça ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, peux-tu créer une séance de vélo en salle pour ça ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, kun je hier een indoor-fietstraining voor maken?"
          }
        }
      }
    },
    "screenshot.chat.reply": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles klar! Wir machen ein strukturiertes norwegisches 4x4 auf dem Indoor-Bike. Ich baue es dir so, dass du es direkt in Bloom starten und die Intervalle rocken kannst:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotcha! Let's lock in a structured Norwegian 4x4 indoor cycling workout you can do on your trainer. I'll build it so you can launch it in Bloom and crush those intervals:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hecho! Vamos con un 4x4 noruego estructurado en bici indoor. Te lo preparo para que puedas lanzarlo en Bloom y comerte esos intervalos:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compris ! On part sur une séance structurée de 4x4 norvégien à vélo en salle, à faire sur ton home-trainer. Je la prépare pour que tu puisses la lancer dans Bloom et enchaîner les intervalles :"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Compris ! On part sur une séance structurée de 4x4 norvégien à vélo en salle, à faire sur ton home-trainer. Je la prépare pour que tu puisses la lancer dans Bloom et enchaîner les intervalles :"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Helder! We doen een gestructureerde Noorse 4x4 op de indoor trainer. Ik zet 'm klaar zodat je 'm in Bloom kunt starten en die intervallen kunt knallen:"
          }
        }
      }
    },
