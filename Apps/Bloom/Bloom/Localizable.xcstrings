          }
        }
      }
    },
    "Your cardio fitness is %@%@ mL/kg/min.": {
      "comment": "Year in Bloom cardio summary. Placeholders are a fitness level and a VO2 max value.",
      "localizations": {
        "en": {
          "stringUnit": {
