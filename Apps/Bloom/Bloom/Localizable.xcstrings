    "Enable Sleep Focus and wear your Apple Watch to bed to track your sleep metrics.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Schlaf-Fokus und trage deine Apple Watch nachts, um deine Schlafwerte zu erfassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le mode de concentration Sommeil et portez votre Apple Watch la nuit pour suivre vos données de sommeil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le mode de concentration Sommeil et porte ton Apple Watch la nuit pour suivre tes données de sommeil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de slaapfocus aan en draag je Apple Watch in bed om je slaapwaarden bij te houden."
