    "Very frequent bowel movements (less than 8 hours apart) may indicate digestive sensitivity, dietary issues, or stress.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr häufiger Stuhlgang (weniger als 8 Stunden Abstand) kann auf eine empfindliche Verdauung, die Ernährung oder Stress hindeuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des selles très fréquentes (moins de 8 heures d'intervalle) peuvent traduire une sensibilité digestive, un problème alimentaire ou du stress."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heel vaak stoelgang (minder dan 8 uur ertussen) kan wijzen op een gevoelige spijsvertering, je voeding of stress."
          }
        }
      }
    },
