            "value": "Je sliep gemiddeld %@ per nacht."
          }
        }
      }
    },
    "You can ask me about your health trends, and I’ll generate insights using your Apple Health data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag mich nach deinen Gesundheitstrends - ich werte deine Apple-Health-Daten für dich aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntame por tus tendencias de salud y generaré análisis con tus datos de Apple Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez-moi des questions sur vos tendances de santé : je produirai des analyses à partir de vos données Apple Santé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose-moi des questions sur tes tendances de santé : je produirai des analyses à partir de tes données Apple Santé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag me naar je gezondheidstrends, dan maak ik inzichten op basis van je Apple Gezondheid-gegevens."
          }
        }
      }
    },
    "You can ask me anything!": {
      "localizations": {
        "de": {
          "stringUnit": {
