    "How much this drink contributes to hydration. Water is 100%, caffeinated drinks are typically 80-90%, alcoholic drinks are lower.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark dieses Getränk zur Flüssigkeitszufuhr beiträgt. Wasser zählt 100 %, koffeinhaltige Getränke meist 80-90 %, alkoholische weniger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contribution de cette boisson à l'hydratation. L'eau compte pour 100 %, les boissons caféinées pour 80 à 90 % en général, et les boissons alcoolisées pour moins."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel dit drankje bijdraagt aan je vochtinname. Water telt voor 100 %, cafeïnehoudende drankjes meestal 80-90 %, alcoholische minder."
          }
        }
      }
    },
