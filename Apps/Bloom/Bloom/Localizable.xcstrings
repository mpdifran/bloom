    "Here's how I'll use your data to spot patterns that affect your daily energy and help you feel more energized.": {
      "comment": "Intro on the onboarding Health permission screen, tailored to the focus the user picked. Spoken by Bud, the app's mascot.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So nutze ich deine Daten, um Muster zu erkennen, die deine tägliche Energie beeinflussen – damit du dich fitter fühlst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así uso tus datos para detectar patrones que afectan a tu energía diaria y ayudarte a sentirte con más vitalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici comment j’utilise vos données pour repérer ce qui influence votre énergie au quotidien et vous aider à vous sentir plus en forme."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici comment j’utilise tes données pour repérer ce qui influence ton énergie au quotidien et t’aider à te sentir plus en forme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo gebruik ik je gegevens om patronen te vinden die je dagelijkse energie beïnvloeden, zodat je je energieker voelt."
          }
        }
      }
    },
    "Hey there! I'm Bud 👋": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey! Ich bin Bud 👋"
          }
