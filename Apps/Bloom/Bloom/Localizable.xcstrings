    "Walking speed is a key indicator of mobility and overall health. Reference lines show typical speeds for different ages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gehgeschwindigkeit ist ein wichtiger Hinweis auf Mobilität und Gesundheit. Die Referenzlinien zeigen typische Werte je Altersgruppe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse de marche est un indicateur clé de la mobilité et de la santé générale. Les lignes de référence indiquent les vitesses habituelles selon l'âge."
          }
        }
      }
    },
    "Want me to help you stay focused on what matters most for your health?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll ich dir helfen, dich auf das Wichtigste für deine Gesundheit zu konzentrieren?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous que je vous aide à rester concentré sur l'essentiel pour votre santé ?"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu que je t'aide à rester concentré sur l'essentiel pour ta santé ?"
          }
        }
      }
    },
