    "screenshot.monitor.insight": {
      "comment": "App Store screenshot: Bud's Insight text on the recovery monitor screen",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Erholungswert ist heute gut – deine Herzfrequenz liegt in deinem gewohnten Ruhebereich, dein Körper erholt sich also gut von der letzten Belastung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your recovery score is good today - your heart rate is in line with your usual resting range, so your body appears to be bouncing back well after recent activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy tu puntuación de recuperación es buena: tu frecuencia cardíaca está en tu rango de reposo habitual, así que tu cuerpo se está recuperando bien de la actividad reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre score de récupération est bon aujourd'hui : votre fréquence cardiaque se situe dans votre plage de repos habituelle, votre corps récupère donc bien après vos dernières séances."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton score de récupération est bon aujourd'hui : ta fréquence cardiaque se situe dans ta plage de repos habituelle, ton corps récupère donc bien après tes dernières séances."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je herstelscore is vandaag goed – je hartslag ligt in je gebruikelijke rustbereik, dus je lichaam herstelt goed van de recente inspanning."
          }
        }
      }
    },
    "screenshot.monitor.suggestion": {
      "comment": "App Store screenshot: the follow-up suggestion under Bud's Insight",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstütze deine Erholung weiter mit lockerer Bewegung, ausreichend Flüssigkeit und einer festen Schlafenszeit, damit das so bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Keep supporting recovery with easy movement, good hydration, and a consistent bedtime to maintain this pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue favoreciendo la recuperación con movimiento suave, buena hidratación y una hora de acostarse constante para mantener esta pauta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à favoriser la récupération avec des mouvements légers, une bonne hydratation et une heure de coucher régulière pour maintenir cette tendance."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue à favoriser la récupération avec des mouvements légers, une bonne hydratation et une heure de coucher régulière pour maintenir cette tendance."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf je herstel ondersteunen met rustige beweging, voldoende drinken en een vaste bedtijd om dit patroon vast te houden."
          }
        }
      }
    },
