    "Enable Sleep Focus and wear your Apple watch to bed in order to track your sleep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Schlaf-Fokus und trage deine Apple Watch nachts, um deinen Schlaf zu erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el modo de concentración Sueño y lleva el Apple Watch en la cama para registrar tu sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le mode de concentration Sommeil et portez votre Apple Watch la nuit pour suivre votre sommeil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le mode de concentration Sommeil et porte ton Apple Watch la nuit pour suivre ton sommeil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de slaapfocus aan en draag je Apple Watch in bed om je slaap bij te houden."
          }
        }
      }
    },
