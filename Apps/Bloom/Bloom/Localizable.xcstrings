    "screenshot.today.advice": {
      "comment": "App Store screenshot: the Today's Advice card content",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach heute eine ruhige 30-Minuten-Einheit in Zone 2, etwa eine lockere Radtour oder einen zügigen Spaziergang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do one steady 30-minute Zone 2 session today, like a moderate bike ride or a brisk walk, to make meaningful progress toward your weekly cardio target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz hoy una sesión constante de 30 minutos en zona 2, como una salida suave en bici o una caminata rápida, y avanza de verdad hacia tu objetivo semanal de cardio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites aujourd'hui une séance régulière de 30 minutes en zone 2, comme un vélo modéré ou une marche rapide, pour bien avancer vers votre objectif cardio de la semaine."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais aujourd'hui une séance régulière de 30 minutes en zone 2, comme un vélo modéré ou une marche rapide, pour bien avancer vers ton objectif cardio de la semaine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe vandaag één rustige sessie van 30 minuten in zone 2, bijvoorbeeld een matige fietsrit of een stevige wandeling, en zet zo een flinke stap naar je cardiodoel."
          }
        }
      }
    },
    "screenshot.today.summary": {
      "comment": "App Store screenshot: Bud's summary paragraph on the Today screen",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach einem soliden Schlafscore und einem besseren biologischen Alter fühlst du dich heute vermutlich ausgeruht und etwas wacher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You likely feel reasonably rested and slightly sharper today after a solid sleep score and a measurable improvement in biological age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy probablemente te sientes bastante descansado y algo más despejado, tras una buena puntuación de sueño y una mejora medible en tu edad biológica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous sentez probablement bien reposé et un peu plus vif aujourd'hui, après un bon score de sommeil et une amélioration mesurable de votre âge biologique."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu te sens probablement bien reposé et un peu plus vif aujourd'hui, après un bon score de sommeil et une amélioration mesurable de ton âge biologique."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voelt je vandaag waarschijnlijk redelijk uitgerust en iets scherper, na een goede slaapscore en een meetbare verbetering van je biologische leeftijd."
          }
        }
      }
    },
