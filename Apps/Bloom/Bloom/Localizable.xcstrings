            "value": "Aktiviere den Schlaf-Fokus und trage deine Apple Watch nachts, um deine Schlafphasen zu erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el modo de concentración Sueño y lleva el Apple Watch en la cama para registrar tus fases del sueño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le mode de concentration Sommeil et portez votre Apple Watch la nuit pour suivre vos phases de sommeil."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
