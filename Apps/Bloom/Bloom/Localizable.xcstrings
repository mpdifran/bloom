    "Wrist Temperature": {
      "comment": "Display name for monitor metric type",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handgelenktemperatur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatura de la muñeca"
          }
        },
        "fr": {
