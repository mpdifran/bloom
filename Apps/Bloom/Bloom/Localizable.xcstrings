        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le mode de concentration Sommeil et porte ton Apple Watch la nuit pour suivre tes données de sommeil."
          }
        }
      }
    },
    "Enable Sleep Focus and wear your Apple Watch to bed to track your sleep schedule.": {
      "localizations": {
