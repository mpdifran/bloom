    "Automatically complete the reminder when you log a HIIT workout.": {
      "comment": "Description for reminder trigger type",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerung automatisch abhaken, wenn du ein HIIT-Workout einträgst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca el recordatorio como hecho automáticamente cuando registres un entrenamiento HIIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer automatiquement le rappel comme terminé lorsque vous enregistrez une séance de HIIT."
