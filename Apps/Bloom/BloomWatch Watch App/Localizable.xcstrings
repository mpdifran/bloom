    "Period tracking requires access to Health data. Please enable it in the Health app on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das Periodentracking wird Zugriff auf Gesundheitsdaten benötigt. Aktiviere ihn in der Health-App auf deinem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento de la regla necesita acceso a los datos de Salud. Actívalo en la app Salud de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi des règles nécessite l'accès aux données Santé. Activez-le dans l'app Santé sur votre iPhone."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi des règles nécessite l'accès aux données Santé. Active-le dans l'app Santé sur ton iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het bijhouden van je menstruatie is toegang tot Gezondheid nodig. Schakel dit in in de Gezondheid-app op je iPhone."
          }
        }
      }
    },
