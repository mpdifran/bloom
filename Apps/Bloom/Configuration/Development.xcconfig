BLOOM_APP_NAME = Bloom [Dev]
BLOOM_APP_BUNDLE_ID = com.lotus-labs.bloom.dev
BLOOM_BASE_URL = https:\/\/bloom-development-2c786f378e64.herokuapp.com
BLOOM_BASE_WS_URL = wss:\/\/bloom-development-2c786f378e64.herokuapp.com
BLOOM_APP_GROUP_ID = group.com.lotus-labs.bloom.dev
OTHER_SWIFT_FLAGS = $(inherited) -DDEVELOPMENT

// Localization: extract Swift string literals (Text, LocalizedStringResource, String(localized:))
// into each target's Localizable.xcstrings at build time.
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
