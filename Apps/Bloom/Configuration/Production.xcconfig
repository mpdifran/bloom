// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

BLOOM_APP_NAME = Bloom
BLOOM_APP_BUNDLE_ID = com.lotus-labs.bloom
BLOOM_BASE_URL = https:\/\/api.trybloom.app
BLOOM_BASE_WS_URL = wss:\/\/api.trybloom.app
BLOOM_APP_GROUP_ID = group.com.lotus-labs.bloom
OTHER_SWIFT_FLAGS = $(inherited) -DPRODUCTION

// Localization: extract Swift string literals (Text, LocalizedStringResource, String(localized:))
// into each target's Localizable.xcstrings at build time.
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
