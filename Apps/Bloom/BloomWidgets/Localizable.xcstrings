    "Get personalized insights on what’s boosting (or bumming out) your health. It’s like x-ray vision for your wellness.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte persönliche Erkenntnisse darüber, was deiner Gesundheit guttut (oder ihr zusetzt). Wie ein Röntgenblick für dein Wohlbefinden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez des analyses personnalisées sur ce qui stimule (ou plombe) votre santé. Une véritable radiographie de votre bien-être."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiens des analyses personnalisées sur ce qui stimule (ou plombe) ta santé. Une véritable radiographie de ton bien-être."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg persoonlijke inzichten in wat je gezondheid een boost geeft (of juist onderuithaalt). Als röntgenblik voor je welzijn."
          }
        }
      }
    },
