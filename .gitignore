.DS_Store
xcuserdata
# Anchored: an unanchored "screenshots/" also matched Apps/Bloom/BloomTests/Screenshots,
# silently keeping the capture test out of the repository (core.ignorecase is on).
/screenshots/
crashreports/
fastlane/report.xml
.claude/skills
.env
.env.*
*.p8

# Staging directory for ScreenshotCaptureTests (see Apps/Bloom/Scripts/capture-screenshots.sh)
.screenshots/

# Isolated DerivedData for the screenshot sweep, kept out of Xcode's own so a concurrent build
# doesn't fail with "database is locked"
.screenshot-build/
